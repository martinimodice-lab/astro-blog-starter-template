---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/" class="logo"><img src="/Logo.png" alt="CLAUDIO MARTINI - Limpieza de aire acondicionado" /></a></h2>
		<div class="internal-links">
			<HeaderLink href="/">INICIO</HeaderLink>
			<HeaderLink href="/agenda">AGENDA</HeaderLink>
			<HeaderLink href="/about">CONTACTO</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: linear-gradient(180deg, rgba(7,9,13,0.95), rgba(12,14,20,0.9));
		box-shadow: 0 2px 12px rgba(0,0,0,0.6);
		color: rgb(var(--black));
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: rgb(var(--black));
	}
	h2 a.logo {
		display: flex;
		align-items: center;
		height: 60px;
	}
	h2 a.logo img {
		height: 50px;
		width: auto;
		display: block;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		font-size: 0.9rem;
		color: rgba(var(--gray-dark), 0.95);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: #ffcc00ff;
		color: rgb(var(--black));
	}
	@media (max-width: 720px) {
		nav {
			flex-direction: column;
			align-items: stretch;
		}
	}
</style>
