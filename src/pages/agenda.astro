---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { GOOGLE_CALENDAR_URL, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} — Agenda`} description="Agende seu serviço por Google Calendar em uma página escura." />
	</head>
	<body>
		<Header />
		<main class="agenda-page">
			<section class="agenda-panel">
				<h1>Agenda</h1>
				<p>Use o formulário abaixo para acessar sua agenda do Google em modo escuro.</p>
				<div class="iframe-wrap">
					<iframe
						src={GOOGLE_CALENDAR_URL}
						title="Google Calendar Agenda"
						loading="lazy"
						allow="clipboard-write; encrypted-media"
					></iframe>
				</div>
				<p class="note">Caso o Google Calendar não carregue no iframe, use o botão abaixo para abrir a agenda em outra aba.</p>
				<a class="external-link" href={GOOGLE_CALENDAR_URL} target="_blank" rel="noopener noreferrer">Abrir agenda no Google</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.agenda-page {
		min-height: calc(100vh - 130px);
		padding: 2rem 1rem 3rem;
		background: radial-gradient(circle at top, rgba(255,204,0,0.08), transparent 28%), #07090d;
		color: #f3f0e7;
	}

	.agenda-panel {
		max-width: 1120px;
		margin: 0 auto;
		padding: 2rem;
		background: rgba(12, 14, 20, 0.96);
		border: 1px solid rgba(255, 204, 0, 0.15);
		border-radius: 24px;
		box-shadow: 0 32px 80px rgba(0, 0, 0, 0.45);
	}

	.agenda-panel h1 {
		margin-top: 0;
		color: #ffcc00;
	}

	.agenda-panel p {
		line-height: 1.8;
		color: rgba(243, 240, 231, 0.82);
	}

	.iframe-wrap {
		margin: 2rem 0;
		height: 72vh;
		border-radius: 20px;
		overflow: hidden;
		box-shadow: 0 30px 90px rgba(0, 0, 0, 0.4);
	}

	.iframe-wrap iframe {
		width: 100%;
		height: 100%;
		border: none;
		background: #0b0f14;
	}

	.note {
		margin-bottom: 0.5rem;
		color: rgba(255, 255, 255, 0.72);
	}

	.external-link {
		display: inline-block;
		padding: 0.85rem 1.4rem;
		border-radius: 999px;
		background: #ffcc00;
		color: #0b0f14;
		font-weight: 700;
		text-decoration: none;
	}

	@media (max-width: 820px) {
		.agenda-panel {
			padding: 1.5rem;
		}
		.iframe-wrap {
			height: 60vh;
		}
	}

	@media (max-width: 640px) {
		.agenda-page {
			padding: 1.25rem 0.75rem 2rem;
		}
		.agenda-panel {
			border-radius: 18px;
		}
	}
</style>
